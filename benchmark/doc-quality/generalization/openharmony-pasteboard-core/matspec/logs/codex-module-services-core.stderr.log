    void ProcessNoMatchInfo(const std::vector<DisposableInfo> &noMatchInfoList);

    static constexpr int32_t DISPOSABLE_EXPIRATION_DEFAULT = 100; // ms
    static constexpr int32_t DISPOSABLE_EXPIRATION_MIN = 1; // ms
