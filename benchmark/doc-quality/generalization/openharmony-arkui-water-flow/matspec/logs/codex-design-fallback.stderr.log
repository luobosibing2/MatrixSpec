## 使用示例

### 基础用法
```typescript
@Entry
@Component
struct StepperExample {
  @State currentIndex: number = 0

  build() {
    Stepper() {
      // 步骤 1
      StepperItem() {
        Text('步骤 1 内容')
          .fontSize(24)
          .width('100%')
          .textAlign(TextAlign.Center)
      }
      .nextLabel('下一步')

      // 步骤 2
      StepperItem() {
        Text('步骤 2 内容')
          .fontSize(24)
          .width('100%')
          .textAlign(TextAlign.Center)
      }
      .prevLabel('上一步')
      .nextLabel('下一步')

      // 步骤 3
      StepperItem() {
        Text('步骤 3 内容')
          .fontSize(24)
          .width('100%')
          .textAlign(TextAlign.Center)
      }
      .prevLabel('上一步')
      .nextLabel('完成')
    }
    .onChange((prevIndex: number, index: number) => {
      this.currentIndex = index
      console.info(`从步骤 ${prevIndex} 切换到步骤 ${index}`)
    })
    .onFinish(() => {
      console.info('完成所有步骤')
    })
  }
}
```

### 表单向导示例
