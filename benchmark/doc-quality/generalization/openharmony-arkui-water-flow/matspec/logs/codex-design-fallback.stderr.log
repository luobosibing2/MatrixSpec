30: namespace {
31: bool IsValidLibraryPath(const std::string& libraryPath)
32: {
33: #if defined(__aarch64__) || defined(__x86_64__)
34:     constexpr char trustedPrefix[] = "/system/lib64/";
35: #else
36:     constexpr char trustedPrefix[] = "/system/lib/";
37: #endif
38:     if (libraryPath.empty()) {
39:         return false;
40:     }
41:     if (libraryPath.rfind(trustedPrefix, 0) != 0) {
42:         return false;
43:     }
44:     auto modulePath = libraryPath.substr(sizeof(trustedPrefix) - 1);
45:     if (modulePath.empty() || modulePath.front() == '/' || modulePath.find('\\') != std::string::npos ||
46:         modulePath.find("..") != std::string::npos) {
47:         return false;
48:     }
49:     return true;
50: }
51: } // namespace
