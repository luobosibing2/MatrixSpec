1: #!/bin/bash
2: # OpenHarmony Build Error Analysis Script
3: # Analyzes build logs and extracts relevant error information
4: 
5: set -e
6: 
7: # Color codes for output
8: RED='\033[0;31m'
9: YELLOW='\033[1;33m'
10: GREEN='\033[0;32m'
11: NC='\033[0m' # No Color
12: 
13: # OpenHarmony root directory
14: # Script is at: .../ace_engine/.claude/skills/openharmony-build/scripts/
15: # Need to go up 7 levels to reach OpenHarmony root
16: SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
17: OH_ROOT="$(cd "$SCRIPT_DIR/../../../../../../.." && pwd)"
18: 
19: echo -e "${GREEN}OpenHarmony Build Error Analyzer${NC}"
20: echo "OpenHarmony Root: $OH_ROOT"
21: echo ""
22: 
23: # Check if product name is provided
24: if [ -z "$1" ]; then
25:     echo -e "${YELLOW}Usage: $0 <product-name>${NC}"
26:     echo "Example: $0 rk3568"
27:     echo ""
28:     echo "Available products in out/:"
29:     ls -1 "$OH_ROOT/out/" 2>/dev/null | grep -v "sdk\|gen\|kernel" || echo "  No products found"
30:     exit 1
31: fi
32: 
33: PRODUCT_NAME="$1"
34: BUILD_LOG="$OH_ROOT/out/$PRODUCT_NAME/build.log"
35: 
36: # Check if build log exists
37: if [ ! -f "$BUILD_LOG" ]; then
38:     echo -e "${RED}Error: Build log not found: $BUILD_LOG${NC}"
39:     echo ""
40:     echo "Searching for alternative log files..."
41:     find "$OH_ROOT/out/$PRODUCT_NAME" -name "*.log" -type f 2>/dev/null | head -5
42:     exit 1
43: fi
44: 
45: echo -e "${GREEN}Analyzing build log: $BUILD_LOG${NC}"
46: echo ""
47: 
48: # Extract summary information
49: echo -e "${YELLOW}=== Build Summary ===${NC}"
50: echo "Log file: $BUILD_LOG"
51: echo "File size: $(du -h "$BUILD_LOG" | cut -f1)"
52: echo "Last modified: $(stat -c '%y' "$BUILD_LOG" 2>/dev/null || stat -f '%Sm' "$BUILD_LOG")"
53: echo ""
54: 
55: # Check for build completion
56: if grep -q "build.*successful" "$BUILD_LOG" 2>/dev/null; then
57:     echo -e "${GREEN}Status: Build completed successfully${NC}"
58: else
59:     echo -e "${RED}Status: Build failed or incomplete${NC}"
60: fi
61: echo ""
62: 
63: # Extract error statistics
64: echo -e "${YELLOW}=== Error Statistics ===${NC}"
65: ERROR_COUNT=$(grep -ci "error:" "$BUILD_LOG" 2>/dev/null || echo "0")
66: WARNING_COUNT=$(grep -ci "warning:" "$BUILD_LOG" 2>/dev/null || echo "0")
67: FATAL_COUNT=$(grep -ci "fatal" "$BUILD_LOG" 2>/dev/null || echo "0")
68: 
69: echo "Total errors: $ERROR_COUNT"
70: echo "Total warnings: $WARNING_COUNT"
71: echo "Fatal errors: $FATAL_COUNT"
72: echo ""
73: 
74: # Extract fatal errors
75: echo -e "${YELLOW}=== Fatal Errors ===${NC}"
76: if grep -i "fatal" "$BUILD_LOG" 2>/dev/null | head -20 | grep -q .; then
77:     grep -i "fatal" "$BUILD_LOG" 2>/dev/null | head -20 | while IFS= read -r line; do
78:         echo -e "${RED}$line${NC}"
79:     done
80: else

--- .claude/skills/openharmony-build/scripts/check_fast_rebuild.sh ---
1: #!/bin/bash
2: # Helper script to determine if fast-rebuild can be used
3: # Checks if any GN files (BUILD.gn, *.gni) have been modified recently
4: 
5: set -e
6: 
7: # Color codes
8: GREEN='\033[0;32m'
9: YELLOW='\033[1;33m'
10: RED='\033[0;31m'
11: NC='\033[0m' # No Color
12: 
13: # Find OpenHarmony root
14: SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
15: OH_ROOT="$(cd "$SCRIPT_DIR/../../../../../../.." && pwd)"
16: 
17: # Default time window in minutes (check for changes in last N minutes)
18: TIME_WINDOW=${1:-30}
19: 
20: echo -e "${GREEN}OpenHarmony Fast Rebuild Checker${NC}"
21: echo "OpenHarmony Root: $OH_ROOT"
22: echo "Time window: last $TIME_WINDOW minutes"
23: echo ""
24: 
25: # Check if build output exists
26: if [ ! -d "$OH_ROOT/out" ]; then
27:     echo -e "${RED}✗ No build output found${NC}"
28:     echo "This appears to be a first-time build."
29:     echo "Recommended: Use standard build command"
30:     echo "  ./build.sh --export-para PYCACHE_ENABLE:true --product-name rk3568 --ccache"
31:     exit 0
32: fi
33: 
34: # Find recently modified GN files
35: echo -e "${YELLOW}Checking for recently modified GN files...${NC}"
36: 
37: RECENT_GN_FILES=$(find "$OH_ROOT" -type f \( -name "BUILD.gn" -o -name "*.gni" \) -mmin -$TIME_WINDOW 2>/dev/null || true)
38: 
39: if [ -z "$RECENT_GN_FILES" ]; then
40:     echo -e "${GREEN}✓ No GN files modified in the last $TIME_WINDOW minutes${NC}"
41:     echo ""
42:     echo -e "${GREEN}✓ Safe to use --fast-rebuild${NC}"
43:     echo ""
44:     echo "Recommended fast rebuild command:"
45:     echo "  cd $OH_ROOT"
46:     echo "  ./build.sh --export-para PYCACHE_ENABLE:true --product-name rk3568 --ccache --fast-rebuild"
47:     echo ""
48:     echo "Or for specific component:"
49:     echo "  ./build.sh --export-para PYCACHE_ENABLE:true --product-name rk3568 --build-target ace_engine --ccache --fast-rebuild"
50: else
51:     echo -e "${RED}✗ Found recently modified GN files:${NC}"
52:     echo ""
53:     echo "$RECENT_GN_FILES" | while IFS= read -r file; do
54:         echo "  - ${file#$OH_ROOT/}"
55:     done
56:     echo ""
57:     echo -e "${YELLOW}⚠ GN files have been modified${NC}"
58:     echo ""
59:     echo "Recommended: Use standard build command (do NOT use --fast-rebuild)"
60:     echo "  cd $OH_ROOT"
61:     echo "  ./build.sh --export-para PYCACHE_ENABLE:true --product-name rk3568 --ccache"
62: fi
63: 
64: echo ""
65: echo "To check a different time window:"
66: echo "  $0 <minutes>"
67: echo ""
68: echo "Example: Check last 60 minutes"
69: echo "  $0 60"
70: 

