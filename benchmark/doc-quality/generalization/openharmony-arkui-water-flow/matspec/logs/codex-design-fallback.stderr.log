@Entry
@Component
struct FormWizardExample {
  @State currentStep: number = 0
  @State formData: Record<string, string> = {}

  build() {
    Stepper() {
      // 步骤 1: 基本信息
      StepperItem() {
        Column({ space: 20 }) {
