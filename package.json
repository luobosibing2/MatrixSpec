{
  "name": "matspec-community",
  "version": "0.4.1-beta.3",
  "type": "module",
  "description": "MatSpec specification-driven development CLI.",
  "bin": {
    "matspec": "bin/matspec.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "matspec": "node ./bin/matspec.js",
    "web": "node ./scripts/serve-web.js",
    "test": "node --test",
    "test:e2e": "pwsh -NoLogo -NoProfile -File ./scripts/psmux-workflow-e2e.ps1",
    "test:e2e:codex-history": "pwsh -NoLogo -NoProfile -File ./scripts/psmux-codex-history-e2e.ps1",
    "test:e2e:codex-revision": "pwsh -NoLogo -NoProfile -File ./scripts/psmux-codex-history-e2e.ps1 -ExerciseRevision -Profile standard -Model gpt-5.6-terra -ReasoningEffort high -AllowDangerFullAccess -KeepArtifacts",
    "prepare": "node ./scripts/fix-bin-perms.js",
    "postinstall": "node ./scripts/fix-bin-perms.js"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.8.4",
    "iconv-lite": "^0.7.0",
    "ignore": "^7.0.5",
    "yaml": "^2.8.1"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "workflow-packs",
    "docs/full-spec.md",
    "docs/full-design.md",
    "packages",
    "scripts"
  ],
  "license": "MIT",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "devDependencies": {},
  "repository": {
    "type": "git",
    "url": "git@gitcode.com:OpenMatrix/MatrixSpec.git"
  },
  "keywords": [],
  "author": ""
}
